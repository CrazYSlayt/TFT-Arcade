{
  "buildCommand": "node build.js",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "tftarcade.com" }], "destination": "https://www.tftarcade.com/:path*", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "tft-arcade.vercel.app" }], "destination": "https://www.tftarcade.com/:path*", "permanent": true },
    { "source": "/simulatoren", "destination": "/simulators", "permanent": true },
    { "source": "/simulatoren/:slug", "destination": "/simulators/:slug", "permanent": true },
    { "source": "/quiz/tft-champion-kosten-quiz", "destination": "/quiz/tft-champion-cost-quiz", "permanent": true },
    { "source": "/bestenliste", "destination": "/leaderboard", "permanent": true },
    { "source": "/ueber-tft-arcade", "destination": "/about", "permanent": true },
    { "source": "/impressum", "destination": "/legal-notice", "permanent": true },
    { "source": "/datenschutz", "destination": "/privacy", "permanent": true },
    { "source": "/challenges/tft-3-star-rush", "destination": "/simulators/tft-roll-simulator", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/(css|js|img|brand)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    }
  ]
}
